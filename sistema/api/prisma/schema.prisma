generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  role      String   @default("admin")
  ativo     Boolean  @default(true)
  senhaAlteradaEm DateTime? @map("senha_alterada_em")
  criadoEm  DateTime @default(now()) @map("criado_em")

  leadsResponsavel Lead[]        @relation("LeadResponsavel")
  atividades       LeadAtividade[]
  lancamentos      Lancamento[]

  @@map("usuarios")
}

model Empresa {
  id             Int       @id @default(autoincrement())
  nome           String
  segmento       String?
  cnpj           String?
  site           String?
  telefone       String?
  email          String?
  contatoNome    String?   @map("contato_nome")
  contatoCargo   String?   @map("contato_cargo")
  cidade         String?
  uf             String?
  perfilLoja     String?   @map("perfil_loja")
  areaMinima     Decimal?  @map("area_minima")
  areaMaxima     Decimal?  @map("area_maxima")
  regioesInteresse String? @map("regioes_interesse")
  observacoes    String?
  status         String    @default("ativo")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")
  razaoSocial    String? @map("razao_social")
  endereco       String?
  demandas       Demanda[]
  oportunidades  Oportunidade[]
  lancamentos    Lancamento[]
  leads          Lead[]

  @@map("empresas")
}

model Lead {
  id             Int           @id @default(autoincrement())
  nome           String
  telefone       String?
  email          String?
  origem         String        @default("site") // site | anuncio | indicacao | outro
  interesse      String?
  status         String        @default("novo") // novo | em_contato | qualificado | convertido | perdido
  observacoes    String?
  empresaId      Int?          @map("empresa_id")
  oportunidadeId Int?          @map("oportunidade_id")
  responsavelId  Int?          @map("responsavel_id")
  proximaAcao    String?       @map("proxima_acao")
  proximaAcaoEm  DateTime?     @map("proxima_acao_em")
  criadoEm       DateTime      @default(now()) @map("criado_em")
  atualizadoEm   DateTime      @updatedAt @map("atualizado_em")
  empresa        Empresa?      @relation(fields: [empresaId], references: [id])
  oportunidade   Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  responsavel    Usuario?      @relation("LeadResponsavel", fields: [responsavelId], references: [id])
  interacoes     LeadInteracao[]
  atividades     LeadAtividade[]

  @@index([empresaId])
  @@map("leads")
}

model LeadInteracao {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  mensagem  String?
  interesse String?
  criadoEm  DateTime @default(now()) @map("criado_em")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_interacoes")
}

model LeadAtividade {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  tipo      String   @default("nota") // nota | ligacao | whatsapp | email | visita | status
  texto     String
  autorId   Int?     @map("autor_id")
  criadoEm  DateTime @default(now()) @map("criado_em")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  autor     Usuario? @relation(fields: [autorId], references: [id])

  @@index([leadId])
  @@map("lead_atividades")
}

model Sequencia {
  nome  String @id
  valor Int    @default(0)

  @@map("sequencias")
}

model Proprietario {
  id           Int      @id @default(autoincrement())
  tipoPessoa   String   @default("pf") @map("tipo_pessoa") // pf | pj
  nome         String
  documento    String?
  telefone     String?
  email        String?
  cidade       String?
  uf           String?
  observacoes  String?
  status       String   @default("ativo") // ativo | inativo
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  imoveis      Imovel[]

  @@map("proprietarios")
}

model Parceiro {
  id           Int      @id @default(autoincrement())
  nome         String
  tipo         String?  // corretor | imobiliaria | indicador | outro
  telefone     String?
  email        String?
  cidade       String?
  uf           String?
  observacoes  String?
  status       String   @default("ativo") // ativo | inativo
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  imoveis      Imovel[]

  @@map("parceiros")
}

model Imovel {
  id              Int      @id @default(autoincrement())
  vagas           Int?
  acessibilidade  String?
  infraestrutura  String?
  restricoesUso   String? @map("restricoes_uso")
  luvas           Decimal?
  valorPonto      Decimal? @map("valor_ponto")
  carenciaMeses   Int? @map("carencia_meses")
  codigo          String   @unique
  titulo          String?
  tipo            String   @default("locacao") // locacao | venda (venda direta) | passagem_ponto
  categoria       String?  @default("loja") // loja | predio | terreno | outro
  status          String   @default("disponivel") // disponivel | negociacao | locado | vendido | inativo
  endereco        String
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String
  uf              String   @default("RJ")
  cep             String?
  latitude        Float?
  longitude       Float?
  areaTotal       Decimal? @map("area_total")
  areaUtil        Decimal? @map("area_util")
  pisoAreaVenda   Decimal? @map("piso_area_venda")
  jirau           Decimal?
  mezanino        Decimal?
  peDireito       Decimal? @map("pe_direito")
  frenteImovel    Decimal? @map("frente_imovel")
  cdu             Decimal?
  aluguel         Decimal?
  condominio      Decimal?
  iptu            Decimal?
  precoVenda      Decimal? @map("preco_venda")
  periodoContrato String?  @map("periodo_contrato")
  proprietario    String?
  telProprietario String?  @map("tel_proprietario")
  proprietarioId  Int?     @map("proprietario_id")
  parceiroId      Int?     @map("parceiro_id")
  googleMapsUrl   String?  @map("google_maps_url")
  googleDriveUrl  String?  @map("google_drive_url")
  descricao       String?
  observacoes     String?
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")
  proprietarioRel Proprietario? @relation(fields: [proprietarioId], references: [id], onDelete: SetNull)
  parceiro        Parceiro?     @relation(fields: [parceiroId], references: [id], onDelete: SetNull)
  fotos           ImovelFoto[]
  areas           ImovelArea[]
  documentos      ImovelDocumento[]
  analises        AnaliseMercado[]
  oportunidades   Oportunidade[]
  despesas        ImovelDespesa[]
  lancamentos     Lancamento[]

  @@index([proprietarioId])
  @@index([parceiroId])
  @@map("imoveis")
}

model ImovelDespesa {
  id            Int       @id @default(autoincrement())
  imovelId      Int       @map("imovel_id")
  descricao     String
  valor         Decimal
  data          DateTime?
  estornada     Boolean   @default(false)
  estornadoEm   DateTime? @map("estornado_em")
  estornoMotivo String?   @map("estorno_motivo")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  criadoPorId   Int?      @map("criado_por_id")
  imovel        Imovel    @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@index([imovelId])
  @@map("imovel_despesas")
}

// Composição de áreas do imóvel (térreo, 2º piso, jirau...). A ABL (areaTotal) sugere a soma.
model ImovelArea {
  id       Int     @id @default(autoincrement())
  imovelId Int     @map("imovel_id")
  nome     String
  area     Decimal
  ordem    Int     @default(0)
  imovel   Imovel  @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@index([imovelId])
  @@map("imovel_areas")
}

model ImovelFoto {
  id        Int      @id @default(autoincrement())
  imovelId  Int      @map("imovel_id")
  arquivo   String
  legenda   String?
  ordem     Int      @default(0)
  principal Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")
  imovel    Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("imovel_fotos")
}

model ImovelDocumento {
  id        Int      @id @default(autoincrement())
  imovelId  Int      @map("imovel_id")
  tipo      String // planta | inteligencia | pre_analise | rig | avcb | convencao | iptu_doc | outro
  nome      String
  url       String?
  arquivo   String?
  criadoEm  DateTime @default(now()) @map("criado_em")
  imovel    Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("imovel_documentos")
}

model AnaliseMercado {
  id           Int      @id @default(autoincrement())
  imovelId     Int      @map("imovel_id")
  score        Int?
  resumo       String?
  conteudoJson String?  @map("conteudo_json")
  modelo       String   @default("motor-interno")
  criadoEm     DateTime @default(now()) @map("criado_em")
  imovel       Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("analises_mercado")
}

model Lancamento {
  id             Int       @id @default(autoincrement())
  tipo           String    // receita | despesa
  categoria      String    // aluguel | comissao | repasse | condominio | iptu | taxa | outro
  descricao      String
  valor          Decimal
  competencia    DateTime? // mês de referência (data civil)
  vencimento     DateTime? // data civil de vencimento
  status         String    @default("previsto") // previsto | pago | estornado
  pagoEm         DateTime? @map("pago_em")
  valorPago      Decimal?  @map("valor_pago")
  formaPagamento String?   @map("forma_pagamento")
  estornadoEm    DateTime? @map("estornado_em")
  estornoMotivo  String?   @map("estorno_motivo")
  pagador        String?   // quem paga (receita) ou é cobrado
  beneficiario   String?   // quem recebe o valor
  comprovante    String?   // arquivo em uploads/
  imovelId       Int?      @map("imovel_id")
  empresaId      Int?      @map("empresa_id")
  oportunidadeId Int?      @map("oportunidade_id")
  criadoPorId    Int?      @map("criado_por_id")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  imovel         Imovel?       @relation(fields: [imovelId], references: [id])
  empresa        Empresa?      @relation(fields: [empresaId], references: [id])
  oportunidade   Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  criadoPor      Usuario?      @relation(fields: [criadoPorId], references: [id])

  @@index([tipo, status])
  @@index([vencimento])
  @@index([imovelId])
  @@index([empresaId])
  @@map("lancamentos")
}

model Oportunidade {
  demandaId Int? @map("demanda_id")
  demanda Demanda? @relation(fields: [demandaId], references: [id], onDelete: SetNull)
  finalidade String?
  proximaAcao String? @map("proxima_acao")
  proximaAcaoEm String? @map("proxima_acao_em")
  id         Int      @id @default(autoincrement())
  imovelId   Int      @map("imovel_id")
  empresaId  Int      @map("empresa_id")
  etapa      String   @default("apresentado") // apresentado | visita | proposta | negociacao | fechado | perdido
  modalidade String?  // expansao_redes | locacao_direta | passagem_ponto
  observacao String?
  criadoEm   DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  imovel     Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  leads      Lead[]
  lancamentos Lancamento[]

  @@map("oportunidades")
}

model Demanda {
  id Int @id @default(autoincrement())
  empresaId Int @map("empresa_id")
  empresa Empresa @relation(fields: [empresaId], references: [id])
  titulo String
  tipo String @default("locacao")
  finalidade String @default("expansao_redes")
  objetivo String?
  unidades Int?
  prazo String?
  regioesInteresse String? @map("regioes_interesse")
  perfilImovel String? @map("perfil_imovel")
  areaMinima Decimal? @map("area_minima")
  areaMaxima Decimal? @map("area_maxima")
  frenteMinima Decimal? @map("frente_minima")
  peDireitoMinimo Decimal? @map("pe_direito_minimo")
  vagasMinimas Int? @map("vagas_minimas")
  acessibilidade String?
  exigencias String?
  aluguelMinimo Decimal? @map("aluguel_minimo")
  aluguelMaximo Decimal? @map("aluguel_maximo")
  compraMinima Decimal? @map("compra_minima")
  compraMaxima Decimal? @map("compra_maxima")
  cdu Decimal?
  luvas Decimal?
  valorPonto Decimal? @map("valor_ponto")
  carenciaMeses Int? @map("carencia_meses")
  investimento Decimal?
  restricoes String?
  responsavelEmpresa String? @map("responsavel_empresa")
  consultor String?
  inicioEm String? @map("inicio_em")
  proximaAcao String? @map("proxima_acao")
  proximaAcaoEm String? @map("proxima_acao_em")
  status String @default("aberta")
  observacoes String?
  criadoEm DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  oportunidades Oportunidade[]
  documentos DemandaDocumento[]
  atividades DemandaAtividade[]
  propostas PropostaServico[]
  @@index([empresaId])
  @@map("demandas")
}
model DemandaDocumento {
  id Int @id @default(autoincrement())
  demandaId Int @map("demanda_id")
  demanda Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  tipo String
  nome String
  url String
  criadoEm DateTime @default(now()) @map("criado_em")
  @@map("demanda_documentos")
}
model DemandaAtividade {
  id Int @id @default(autoincrement())
  demandaId Int @map("demanda_id")
  demanda Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  tipo String @default("nota")
  texto String
  criadoEm DateTime @default(now()) @map("criado_em")
  @@map("demanda_atividades")
}
model PropostaServico {
  id Int @id @default(autoincrement())
  demandaId Int @map("demanda_id")
  demanda Demanda @relation(fields: [demandaId], references: [id])
  titulo String
  escopo String
  honorarios Decimal?
  prazo String?
  condicoes String?
  status String @default("rascunho")
  criadoEm DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  @@map("propostas_servico")
}
model GlossarioTermo {
  id Int @id @default(autoincrement())
  termo String @unique
  nomeExtenso String? @map("nome_extenso")
  categoria String
  significado String
  exemplo String?
  aliases String?
  relacionados String?
  fonte String?
  revisadoEm String? @map("revisado_em")
  @@map("glossario_termos")
}
model BenchmarkLocacao {
  id Int @id @default(autoincrement())
  local String @unique
  municipio String
  corredor String
  valorM2 Decimal @map("valor_m2")
  minimoM2 Decimal @map("minimo_m2")
  maximoM2 Decimal @map("maximo_m2")
  classe String
  fonte String
  @@map("benchmarks_locacao")
}
