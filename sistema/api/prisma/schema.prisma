generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  role      String   @default("admin")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("usuarios")
}

model Empresa {
  id             Int       @id @default(autoincrement())
  nome           String
  segmento       String?
  cnpj           String?
  site           String?
  telefone       String?
  email          String?
  contatoNome    String?   @map("contato_nome")
  contatoCargo   String?   @map("contato_cargo")
  cidade         String?
  uf             String?
  perfilLoja     String?   @map("perfil_loja")
  areaMinima     Decimal?  @map("area_minima")
  areaMaxima     Decimal?  @map("area_maxima")
  regioesInteresse String? @map("regioes_interesse")
  observacoes    String?
  status         String    @default("ativo")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")
  oportunidades  Oportunidade[]

  @@map("empresas")
}

model Lead {
  id           Int      @id @default(autoincrement())
  nome         String
  telefone     String?
  email        String?
  origem       String   @default("site") // site | anuncio | indicacao | outro
  interesse    String?
  status       String   @default("novo") // novo | em_contato | qualificado | convertido | perdido
  observacoes  String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("leads")
}

model Proprietario {
  id           Int      @id @default(autoincrement())
  tipoPessoa   String   @default("pf") @map("tipo_pessoa") // pf | pj
  nome         String
  documento    String?
  telefone     String?
  email        String?
  cidade       String?
  uf           String?
  observacoes  String?
  status       String   @default("ativo") // ativo | inativo
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  imoveis      Imovel[]

  @@map("proprietarios")
}

model Parceiro {
  id           Int      @id @default(autoincrement())
  nome         String
  tipo         String?  // corretor | imobiliaria | indicador | outro
  telefone     String?
  email        String?
  cidade       String?
  uf           String?
  observacoes  String?
  status       String   @default("ativo") // ativo | inativo
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  imoveis      Imovel[]

  @@map("parceiros")
}

model Imovel {
  id              Int      @id @default(autoincrement())
  codigo          String   @unique
  titulo          String?
  tipo            String   @default("locacao") // locacao | venda
  categoria       String?  @default("loja") // loja | predio | terreno | outro
  status          String   @default("disponivel") // disponivel | negociacao | locado | vendido | inativo
  endereco        String
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String
  uf              String   @default("RJ")
  cep             String?
  latitude        Float?
  longitude       Float?
  areaTotal       Decimal? @map("area_total")
  areaUtil        Decimal? @map("area_util")
  pisoAreaVenda   Decimal? @map("piso_area_venda")
  jirau           Decimal?
  mezanino        Decimal?
  peDireito       Decimal? @map("pe_direito")
  frenteImovel    Decimal? @map("frente_imovel")
  cdu             Decimal?
  aluguel         Decimal?
  condominio      Decimal?
  iptu            Decimal?
  precoVenda      Decimal? @map("preco_venda")
  periodoContrato String?  @map("periodo_contrato")
  proprietario    String?
  telProprietario String?  @map("tel_proprietario")
  proprietarioId  Int?     @map("proprietario_id")
  parceiroId      Int?     @map("parceiro_id")
  googleMapsUrl   String?  @map("google_maps_url")
  googleDriveUrl  String?  @map("google_drive_url")
  descricao       String?
  observacoes     String?
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")
  proprietarioRel Proprietario? @relation(fields: [proprietarioId], references: [id], onDelete: SetNull)
  parceiro        Parceiro?     @relation(fields: [parceiroId], references: [id], onDelete: SetNull)
  fotos           ImovelFoto[]
  documentos      ImovelDocumento[]
  analises        AnaliseMercado[]
  oportunidades   Oportunidade[]
  despesas        ImovelDespesa[]

  @@index([proprietarioId])
  @@index([parceiroId])
  @@map("imoveis")
}

model ImovelDespesa {
  id        Int       @id @default(autoincrement())
  imovelId  Int       @map("imovel_id")
  descricao String
  valor     Decimal
  data      DateTime?
  criadoEm  DateTime  @default(now()) @map("criado_em")
  imovel    Imovel    @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@index([imovelId])
  @@map("imovel_despesas")
}

model ImovelFoto {
  id        Int      @id @default(autoincrement())
  imovelId  Int      @map("imovel_id")
  arquivo   String
  legenda   String?
  ordem     Int      @default(0)
  principal Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")
  imovel    Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("imovel_fotos")
}

model ImovelDocumento {
  id        Int      @id @default(autoincrement())
  imovelId  Int      @map("imovel_id")
  tipo      String // planta | inteligencia | pre_analise | rig | avcb | convencao | iptu_doc | outro
  nome      String
  url       String?
  arquivo   String?
  criadoEm  DateTime @default(now()) @map("criado_em")
  imovel    Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("imovel_documentos")
}

model AnaliseMercado {
  id           Int      @id @default(autoincrement())
  imovelId     Int      @map("imovel_id")
  score        Int?
  resumo       String?
  conteudoJson String?  @map("conteudo_json")
  modelo       String   @default("motor-interno")
  criadoEm     DateTime @default(now()) @map("criado_em")
  imovel       Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("analises_mercado")
}

model Oportunidade {
  id         Int      @id @default(autoincrement())
  imovelId   Int      @map("imovel_id")
  empresaId  Int      @map("empresa_id")
  etapa      String   @default("apresentado") // apresentado | visita | proposta | negociacao | fechado | perdido
  observacao String?
  criadoEm   DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  imovel     Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("oportunidades")
}
